# ─── Database (Supabase Postgres) ───────────────────────────────
# Supabase dashboard -> your project -> "Connect" button -> Session pooler
# Use the SESSION pooler (port 5432), not the transaction pooler (6543):
# this server is a long-running process (it also runs Socket.IO), not
# serverless functions, so it doesn't need transaction-mode pooling.
# If your DB password has special characters (@ # % etc.), URL-encode them.
DATABASE_URL="postgresql://postgres.iqurvvxmfjfvlkvfsanq:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# ─── Auth (Supabase Auth) ───────────────────────────────────────
# Project Settings -> API in the Supabase dashboard. Used to verify the
# signature on tokens the frontend sends - no secret key needed here,
# verification uses the project's public JWKS endpoint.
SUPABASE_URL="https://iqurvvxmfjfvlkvfsanq.supabase.co"

# ─── Server ──────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# URL of the deployed frontend, used for Socket.IO CORS
CLIENT_URL="http://127.0.0.1:8000"
